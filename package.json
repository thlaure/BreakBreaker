{
  "name": "breakbreaker",
  "version": "1.5.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "bench": "node scripts/bench-sim.mjs",
    "assets": "node scripts/fetch-assets.mjs && node scripts/build-lpc.mjs && node scripts/optimize-png.mjs",
    "hero": "node scripts/build-hero.mjs",
    "hero:halloween": "node scripts/build-hero.mjs --halloween",
    "favicon": "node scripts/build-favicon.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.5",
    "@typescript/native": "npm:typescript@7.0.2",
    "adm-zip": "0.6.1",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "pngjs": "7.0.0",
    "prettier": "3.9.10",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
